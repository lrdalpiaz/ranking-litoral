extends layout

block content
  .container.mt-4#main-container(data-tournament=selectedTournament data-class=selectedClass data-group=selectedGroup)
    .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.gap-3.mb-4(data-aos="fade-down")
      div
        h2.fw-bold.text-uppercase(style="letter-spacing: 1px;") 🧪 Simulador de Resultados
        p.text-muted.small.mb-0 Projete os resultados restantes e veja a classificação mudar em tempo real.
      
      .d-flex.gap-2.mb-3
        button.btn.btn-sm.btn-outline-danger.fw-bold(onclick="resetSimulation()") 
          i.bi.bi-arrow-counterclockwise.me-1
          | LIMPAR APENAS SIMULADOS

    .card.border-0.shadow-sm.mb-4(data-aos="fade-down")
      .card-body.bg-white.p-4
        .row.align-items-end.g-2
          //- Tournament
          .col-md-4
            label.small.text-uppercase.fw-bold.text-muted.mb-1 🏆 Temporada
            select.form-select.form-select-sm.border-success(style="height: 38px;" onchange=`location.href='/simulator?tournamentId=' + this.value + '&class=${selectedClass}&group=${selectedGroup}'`)
              if tournaments && tournaments.length > 0
                each t in tournaments
                  option(value=t._id.toString() selected=(t._id.toString() === selectedTournament))= t.name
              else
                option(disabled) Nenhum torneio encontrado
          .col-md-4
            label.small.text-uppercase.fw-bold.text-muted.mb-1 🎾 Classe
            .btn-group.w-100(style="height: 38px;")
              each c in ['A', 'B', 'C', 'D', 'E', 'F', 'G']
                a.btn.btn-sm.d-flex.align-items-center.justify-content-center(href=`/simulator?tournamentId=${selectedTournament}&class=${c}&group=${selectedGroup}` class=(selectedClass == c ? 'btn-success fw-bold' : 'btn-outline-success'))= `${c}`
          .col-md-4
            label.small.text-uppercase.fw-bold.text-muted.mb-1 👥 Grupo
            .btn-group.w-100(style="height: 38px;")
              if groups && groups.length > 0
                each g in [1, 2, 3, 4]
                  a.btn.btn-sm.d-flex.align-items-center.justify-content-center(
                    href=`/simulator?tournamentId=${selectedTournament}&class=${selectedClass}&group=${g}` 
                    class=(selectedGroup == g ? 'btn-dark fw-bold' : 'btn-outline-dark')
                  )= `${g}`
              else
                button.btn.btn-sm.btn-outline-secondary(disabled) Sem grupos

    .row
      //- COLUNA DE JOGOS
      .col-lg-7.order-2.order-lg-1
        #matches-list-container(data-aos="fade-right" data-aos-delay="200")
          - var currentRound = 0
          if matches && matches.length > 0
            each match, index in matches
              if match.round !== currentRound
                - currentRound = match.round
                .mt-5.mb-3
                  h5.text-uppercase.fw-bold(style="color: var(--clay-orange); border-left: 4px solid var(--clay-orange); padding-left: 15px;") Semana #{currentRound}
              
              .card.mb-2.border-0.shadow-sm(class=match.played ? 'bg-light opacity-75' : '')
                .card-body.py-2
                  .row.align-items-center.text-center.g-0
                    //- Jogador 1
                    .col-12.col-md-3.text-center.text-md-end.pe-md-3.mb-2.mb-md-0
                      span.fw-bold.small.text-uppercase(style="font-size: 0.85rem;")= match.player1
                    
                    //- Inputs Adaptados para Banco de Dados e Simulação
                    .col-12.col-md-6
                      .d-flex.justify-content-center.align-items-end.gap-2
                        .text-center
                          small.d-block.text-muted.fw-bold(style="font-size: 0.65rem;") SET 1
                          .d-flex.gap-1
                            input.form-control.form-control-sm.text-center.sim-input(type="number" style="width:52px; height:38px; padding: 2px;" data-match=index data-set="1" data-player="p1" value=(match.played ? match.set1.p1 : '') disabled=match.played)
                            input.form-control.form-control-sm.text-center.sim-input(type="number" style="width:52px; height:38px; padding: 2px;" data-match=index data-set="1" data-player="p2" value=(match.played ? match.set1.p2 : '') disabled=match.played)
                        
                        .text-center.border-start.border-end.px-2
                          small.d-block.text-muted.fw-bold(style="font-size: 0.65rem;") SET 2
                          .d-flex.gap-1
                            input.form-control.form-control-sm.text-center.sim-input(type="number" style="width:52px; height:38px; padding: 2px;" data-match=index data-set="2" data-player="p1" value=(match.played ? match.set2.p1 : '') disabled=match.played)
                            input.form-control.form-control-sm.text-center.sim-input(type="number" style="width:52px; height:38px; padding: 2px;" data-match=index data-set="2" data-player="p2" value=(match.played ? match.set2.p2 : '') disabled=match.played)
                        
                        .text-center.bg-warning.bg-opacity-10.rounded.px-1
                          small.d-block.text-danger.fw-bold(style="font-size: 0.65rem;") TIE-BREAKÃO
                          .d-flex.gap-1
                            input.form-control.form-control-sm.text-center.sim-input.border-danger.fw-bold(type="number" style="width:52px; height:38px; padding: 2px;" data-match=index data-set="3" data-player="p1" value=(match.set3 && match.played ? match.set3.p1 : '') disabled=match.played)
                            input.form-control.form-control-sm.text-center.sim-input.border-danger.fw-bold(type="number" style="width:52px; height:38px; padding: 2px;" data-match=index data-set="3" data-player="p2" value=(match.set3 && match.played ? match.set3.p2 : '') disabled=match.played)
                    
                    //- Jogador 2
                    .col-12.col-md-3.text-center.text-md-start.ps-md-3.mt-2.mt-md-0
                      span.fw-bold.small.text-uppercase(style="font-size: 0.85rem;")= match.player2
          else
            .text-center.py-5.text-muted Nenhuma partida configurada para este grupo.

      //- COLUNA DA TABELA ASYNC
      .col-lg-5.order-1.order-lg-2.mb-4
        .sticky-top(style="top: 80px; z-index: 1020;")
          .card.shadow-lg.border-0(data-aos="fade-left" data-aos-delay="300")
            .card-header.bg-forest.text-white.py-2
              h6.mb-0 📊 Classificação Simulada
            .card-body.p-0
              .table-responsive
                table.table.table-sm.table-hover.mb-0#sim-table(style="font-size: 0.85rem;")
                  thead.table-light
                    tr
                      th.align-middle
                        .d-flex.align-items-center
                          .d-inline-block(style="width: 20px; margin-right: 0.5rem; flex-shrink: 0;")
                          span Atleta
                      th.text-center Pts
                      th.text-center V
                      th.text-center S
                      th.text-center G
                  tbody
                    //- Renderizado dinamicamente pelo JavaScript

  //- MOTOR DE CÁLCULO E EVENTOS
  script.
    window.initialMatches = !{JSON.stringify(matches || [])};
    window.players = [...new Set(window.initialMatches.flatMap(m => [m.player1, m.player2]))].filter(Boolean);
  
  //- Carrega os scripts externos sem risco de quebras sintáticas do Pug
  script(src="/javascripts/simulator.js")
  script(src="/javascripts/rankingLogic.js")