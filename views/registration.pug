extends layout

block content
  .container.mt-5.mb-5
    .row.justify-content-center
      .col-md-6
        .card.border-0.shadow-sm
          .card-header.bg-success.text-white.py-3
            h5.mb-0.text-uppercase.fw-bold 📝 Cadastrar Novo Jogador
          
          .card-body.p-4
            form#registerForm(autocomplete="off")
              
              //- Campo Nome Livre (Antigo Dropdown Removido)
              .mb-3
                label.small.text-uppercase.fw-bold.text-muted.mb-1 Nome Completo (Obrigatório)
                input#fullName.form-control(type="text" required placeholder="Ex: Rodrigo Silva" style="height: 45px;")
              
              .mb-3
                label.small.text-uppercase.fw-bold.text-muted.mb-1 Apelido / Como quer ser chamado
                input#nickname.form-control(type="text" placeholder="Ex: Rodrigo" style="height: 45px;")
              
              .mb-3
                label.small.text-uppercase.fw-bold.text-muted.mb-1 📱 WhatsApp / Celular (Obrigatório)
                input#phone.form-control(type="text" placeholder="(XX) XXXXX-XXXX" required style="height: 45px;")
              
              .mb-3
                label.small.text-uppercase.fw-bold.text-muted.mb-1 ✉️ E-mail de Acesso (Obrigatório)
                input#email.form-control(type="email" required placeholder="seu-email@provedor.com" style="height: 45px;")
              
              //- Campo Senha Novo
              .mb-4
                label.small.text-uppercase.fw-bold.text-muted.mb-1 🔑 Escolha uma Senha (Mínimo 6 dígitos)
                input#password.form-control(type="password" required placeholder="Crie sua senha de acesso" style="height: 45px;")

              button.btn.btn-success.w-100.fw-bold(type="submit" style="height: 45px;")
                i.bi.bi-person-plus.me-1
                | Concluir Meu Cadastro

  script.
    document.addEventListener('DOMContentLoaded', () => {
        const phoneInput = document.getElementById('phone');
        const form = document.getElementById('registerForm');

        // Máscara de Telefone em Tempo Real
        phoneInput.addEventListener('input', (e) => {
            let x = e.target.value.replace(/\D/g, '').match(/(\d{0,2})(\d{0,5})(\d{0,4})/);
            e.target.value = !x ? x : '(' + x[1] + ') ' + x[2] + (x[3] ? '-' + x[3] : '');
        });

        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const bodyData = {
                fullName: document.getElementById('fullName').value,
                nickname: document.getElementById('nickname').value,
                phone: phoneInput.value,
                email: document.getElementById('email').value,
                password: document.getElementById('password').value
            };

            try {
                // Dispara a requisição para a nossa nova API de criação de usuário
                const response = await fetch('/registration/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(bodyData)
                });

                const result = await response.json();

                if (result.success) {
                    alert(result.message);
                    window.location.href = '/login'; // Redireciona para a tela de login após cadastrar
                } else {
                    // Exibe o erro caso o e-mail já esteja repetido no banco de dados
                    alert("Atenção: " + result.error);
                }
            } catch (err) {
                console.error(err);
                alert("Erro técnico de comunicação ao tentar realizar o cadastro.");
            }
        });
    });
