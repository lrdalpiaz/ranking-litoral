doctype html
html(lang="pt-br")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title RANKING TOP LITORAL NORTE - RS
    //- CONFIGURAÇÃO DO FAVICON
    link(rel="icon" type="image/png" href="/images/favicon-32x32.png")
    //- Se quiser suporte para dispositivos Apple (ícone na tela inicial)
    link(rel="apple-touch-icon" href="/images/favicon-32x32.png")
    //- Bootstrap 5 & Icons
    link(rel="stylesheet" href="/stylesheets/bootstrap.min.css")
    //- link(rel="stylesheet" href="https://jsdelivr.net")    
    //- 2. AOS Animation CSS
    link(href="/stylesheets/aos.css" rel="stylesheet")
    //- Fontes: Playfair Display para títulos (clássico) e Lato para corpo
    link(href="https://googleapis.com" rel="stylesheet")
    link(href="https://cdn.jsdelivr.net/npm/tom-select@2.5.2/dist/css/tom-select.css" rel="stylesheet")
    
    style.
      :root {
        --clay-orange: #d35400; /* Laranja Saibro */
        --clay-dark: #a04000;   /* Saibro Escuro */
        --forest-green: #1b4d3e; /* Verde Roland Garros */
        --cream-bg: #fdfaf5;    /* Creme Clássico */
      }
      
      body {
        font-family: 'Lato', sans-serif;
        background-color: #fdfaf5; 
        background-attachment: fixed;
        /* Centraliza o logo e impede que ele se repita */
        background-position: center;
        background-repeat: no-repeat;
        background-size: 60%; /* Ajuste a porcentagem para aumentar/diminuir o logo no fundo */
        color: #1b4d3e;
        min-height: 100vh;
      }

      h1, h2, h3, .navbar-brand {
        font-family: 'Playfair Display', serif;
        font-weight: 900;
      }

      /* Navbar Elegante */
      .navbar {
        background-color: var(--forest-green) !important;
        border-bottom: 4px solid var(--clay-orange);
        padding: 0.8rem 0;
      }
      .navbar-brand { color: white !important; letter-spacing: 1px; }
      .nav-link { color: rgba(255,255,255,0.9) !important; font-weight: 700; margin: 0 10px; text-transform: uppercase; font-size: 0.85rem; }
      .nav-link:hover { color: var(--clay-orange) !important; }

      /* Cards Estilo Clube */
      .card {
        background: white !important;
        border: none;
        border-radius: 4px; /* Menos arredondado, mais clássico */
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border-top: 5px solid var(--clay-orange);
      }
      .card-header {
        background: white !important;
        border-bottom: 1px solid #eee;
        color: var(--forest-green);
        padding: 1.2rem;
      }

      /* 1. Botão Selecionado / Sólido / Ativo (Estilo Saibro) */
      .btn-success,
      .btn-success:active,
      .btn-success:focus,
      .btn-group .btn-success.active,
      .btn-outline-success.active,
      .btn-group .btn-outline-success.active {
        background-color: #d35400 !important; /* Laranja Saibro */
        border-color: #d35400 !important;
        color: #ffffff !important;
        font-weight: bold;
        box-shadow: 0 4px 8px rgba(211, 84, 0, 0.2);
      }
      
      .btn-success:hover,
      .btn-outline-success.active:hover,
      .btn-group .btn-outline-success.active:hover {
        background-color: #b84600 !important; /* Saibro um pouco mais escuro no hover */
        border-color: #b84600 !important;
        color: #ffffff !important;
      }
    
      /* 2. Botão de Contorno / Não Selecionado (Verde Floresta) */
      .btn-outline-success {
        color: #1b4d3e !important;
        border-color: #1b4d3e !important;
        background-color: transparent !important;
        font-weight: bold;
        transition: all 0.2s ease-in-out;
      }
      
      /* Hover no botão não selecionado: vira Verde Floresta antes de ser clicado */
      .btn-outline-success:hover {
        background-color: #1b4d3e !important;
        border-color: #1b4d3e !important;
        color: #ffffff !important;
      }
    
      /* 3. Badges e Backgrounds de Sucesso */
      .bg-success {
        background-color: #1b4d3e !important;
        color: #ffffff !important;
      }
    
      /* 4. Destaque das Tabelas de Classificados (Fase Inicial e Simulador) */
      .table-success,
      tr.table-success td {
        background-color: rgba(27, 77, 62, 0.12) !important; /* 12% de opacidade do Verde Floresta */
        color: #1b4d3e !important;
        --bs-table-accent-bg: transparent !important;
      }
      /* Borda lateral sofisticada para a zona de classificação */
      table tbody tr.table-success td:first-child {
        border-left: 5px solid #1b4d3e !important;
      }
    
      /* 5. Campos de Seleção e Inputs do Torneio */
      .form-select.border-success,
      .form-control.border-success {
        border-color: #1b4d3e !important;
      }
      .form-select:focus,
      .form-control:focus {
        box-shadow: 0 0 0 0.25rem rgba(27, 77, 62, 0.25) !important;
        border-color: #1b4d3e !important;
      }

      .table thead {
        background-color: var(--forest-green);
        color: white;
      }
      .table-hover tbody tr:hover {
        background-color: rgba(211, 84, 0, 0.05);
      }

      td.table-primary {
          color: #0a58ca !important; /* Azul mais forte para os números */
          border-bottom: transparent !important;
      }
      
      /* Garante que o verde dos classificados não suma com o azul dos pontos */
      tr.table-success td.table-primary {
          background-color: rgba(13, 110, 253, 0.05) !important;
      }

      /* Estado Normal: Força o Verde Floresta e remove cinzas padrões do Bootstrap */
      .nav-pills .nav-link,
      .btn-outline-clay,
      .nav-pills .nav-link:not(.active) {
        color: #1b4d3e !important;
        border: 2px solid #1b4d3e !important;
        background-color: transparent !important;
        font-weight: bold;
        text-transform: uppercase;
        transition: all 0.2s ease-in-out;
        opacity: 1 !important;
      }
    
      /* Estado Hover e Ativo: Força o Laranja Saibro com texto Branco */
      .nav-pills .nav-link:hover,
      .btn-outline-clay:hover,
      .nav-pills .nav-link.active,
      .btn-outline-clay.active {
        background-color: #d35400 !important; /* Laranja Saibro */
        border-color: #d35400 !important;
        color: #ffffff !important;
        box-shadow: 0 4px 8px rgba(211, 84, 0, 0.2) !important;
      }
      /* Badge de destaque */
      .badge.bg-dark { background-color: var(--forest-green) !important; }
      
  body
    nav.navbar.navbar-expand-lg.navbar-dark.sticky-top.mb-4.shadow
      .container
        a.navbar-brand.d-flex.align-items-center(href="/matches/ranking") 
          img.me-2(src="/images/logo-nav.png" alt="Logo" style="height: 40px; width: auto;")
          span.d-none.d-sm-inline RANKING TOP LITORAL NORTE - RS
        
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav")
          span.navbar-toggler-icon
        
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.ms-auto.align-items-center
            li.nav-item
             a.nav-link.text-warning.fw-bold(href="/simulator") 
               i.bi.bi-cpu.me-1
               | Simulador
            li.nav-item
              a.nav-link(href="/matches/ranking") 
                i.bi.bi-trophy.me-1
                | Classificação
            li.nav-item
              a.nav-link(href="/matches/pending") 
                i.bi.bi-calendar3.me-1
                | Agenda
            li.nav-item
              a.nav-link(href="/playoffs/matches") 
                i.bi.bi-diagram-3.me-1
                | Playoffs
            
            //- ALTERAÇÃO: Menu dinâmico baseado na sessão do Usuário Logado
            if user
              li.nav-item.dropdown.ms-lg-3
                a.nav-link.dropdown-toggle.d-flex.align-items-center.gap-1.text-white.fw-semibold#userDropdown(
                  href="#" 
                  role="button" 
                  data-bs-toggle="dropdown" 
                  aria-expanded="false"
                )
                  i.bi.bi-person-circle.fs-5.me-1
                  //- Exibe o apelido se houver, senão o nome completo
                  span Olá, #{user.nickname || user.name}
                
                ul.dropdown-menu.dropdown-menu-end.border-0.shadow-sm.mt-2(aria-labelledby="userDropdown")
                  li
                    //- LINK NOVO: Central de atualização de perfil e senhas
                    a.dropdown-item.py-2(href="/profile")
                      i.bi.bi-gear.me-2.text-muted
                      | Editar Meus Dados
                  
                  //- Condicional do Administrador embutida perfeitamente no sub-menu
                  if user.role === 'admin'
                    li
                      hr.dropdown-divider.my-1
                    li
                      a.dropdown-item.py-2.text-success.fw-bold(href="/tournaments/new")
                        i.bi.bi-plus-circle.me-2
                        | Nova Temporada
                    li
                      a.dropdown-item.py-2.text-warning.fw-bold(href="/registration/admin/users/pending")
                        i.bi.bi-people.me-2
                        | Aprovar Novos Usuários
                  li
                    hr.dropdown-divider.my-1
                  li
                    a.dropdown-item.py-2.text-danger(href="/logout")
                      i.bi.bi-box-arrow-right.me-2
                      | Sair da Conta
            else
              li.nav-item
                a.nav-link(href="/login") Login

    main.pb-5
      block content

    footer.container.text-center.py-5.text-muted.small
      p.mb-1 Litoral Tennis Tour — Rio Grande do Sul
      p.text-uppercase(style="letter-spacing: 2px;") Grand Slam Tradition

    script(src="/javascripts/aos.js")
    script.
      AOS.init({ duration: 800, once: true }); // Inicializa animações
    
    script(src="/javascripts/bootstrap.bundle.min.js")
    script(src="https://cdn.jsdelivr.net/npm/tom-select@2.5.2/dist/js/tom-select.complete.min.js")
